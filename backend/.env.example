# Copy sang backend/.env rồi điền giá trị thật. File .env không được commit.
# Các biến ở đây GHI ĐÈ backend/config.yaml.

# --- LLM & Embeddings -------------------------------------------------------
# Lấy API key tại https://aistudio.google.com/apikey
# Gemini dùng chung một key cho chat và embeddings; để trống EMBEDDINGS_API_KEY
# thì backend tự dùng LLM_API_KEY.
LLM_API_KEY=
EMBEDDINGS_API_KEY=

# Đổi sang provider khác (vLLM local, OpenRouter, Together...) nếu cần:
# LLM_BASE_URL=http://localhost:8024/v1
# LLM_MODEL=qwen3-8b-fp8
# EMBEDDINGS_BASE_URL=http://localhost:8026/v1
# EMBEDDINGS_MODEL=qwen3-embedding-4b

# Chỉ cần khi bật legal_assistant.reranker.enabled
# RERANKER_API_KEY=

# --- Database ---------------------------------------------------------------
# Chạy local (PostgreSQL publish ra host qua docker compose):
LEGAL_DATABASE_URL=postgresql://postgres:postgres@localhost:23432/legal_assistant
# Trong docker compose, service backend dùng: @postgres:5432

# --- Auth -------------------------------------------------------------------
# Sinh bằng: openssl rand -hex 32
JWT_SECRET_KEY=

# --- CORS -------------------------------------------------------------------
# Danh sách origin cách nhau bởi dấu phẩy. Bỏ trống thì mặc định là
# http://localhost:5173 và http://127.0.0.1:5173
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://legal.example.com

# --- Tùy chọn ---------------------------------------------------------------
# APP_HOST=0.0.0.0
# APP_PORT=8023
