# Cấu hình cho docker compose ở root. Copy thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# Chạy backend trực tiếp (không qua Docker) thì dùng backend/.env.example.

# ---------------------------------------------------------------- PostgreSQL --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_assistant
# Port publish ra host, để chạy alembic/script từ máy dev.
POSTGRES_PORT=23432

# ------------------------------------------------------------------- Services --
BACKEND_PORT=8023
FRONTEND_PORT=5173

# ------------------------------------------------------------------- Gemini ---
# Lấy key tại https://aistudio.google.com/apikey (free tier đủ cho môi trường
# phát triển). Cùng một key dùng cho cả chat model và embeddings.
LLM_API_KEY=
EMBEDDINGS_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDINGS_MODEL=gemini-embedding-001

# --------------------------------------------------------------------- Auth ---
# Sinh khóa mới: openssl rand -hex 32
JWT_SECRET_KEY=

# --------------------------------------------------------------------- CORS ---
# Danh sách origin, phân tách bằng dấu phẩy. Khi deploy sau nginx cùng origin
# thì chỉ cần giữ dev server của Vite.
CORS_ALLOW_ORIGINS=http://localhost:5173
